# Consumer Key from your Salesforce External Client App / Connected App
SF_CLIENT_ID=

# Only needed if your app is set to require a secret for the Web Server flow
SF_CLIENT_SECRET=

# Use https://test.salesforce.com for a sandbox, or your My Domain login URL
SF_LOGIN_URL=https://login.salesforce.com

SF_API_VERSION=v62.0
PORT=3000

# Optional: any long random string (otherwise one is generated each start)
SESSION_SECRET=
