# Consumer Key from your Salesforce External Client App / Connected App.
# Leave empty to sign in with your Salesforce CLI (sf) login instead.
SF_CLIENT_ID=

# CLI login only: the org alias or username to use (default: the CLI's default org)
SF_TARGET_ORG=

# CLI login only: full path to sf if it isn't on your PATH
SF_CLI_PATH=

# Only needed if your app is set to require a secret for the Web Server flow
SF_CLIENT_SECRET=

# Use https://test.salesforce.com for a sandbox, or your My Domain login URL
SF_LOGIN_URL=https://login.salesforce.com

SF_API_VERSION=v62.0
PORT=3000

# Optional: any long random string (otherwise one is generated each start)
SESSION_SECRET=

# Optional: where the local SQLite copy of your records is kept (default: ./data/sf-desk.db)
SF_DESK_DB=

# Optional: the Deal Support object's API name, if finding it by its label "Deal Support" doesn't work
SF_DEAL_SUPPORT_OBJECT=

# Optional: its lookup field to Opportunity, if it has more than one
SF_DEAL_SUPPORT_OPP_FIELD=
