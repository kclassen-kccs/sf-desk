<?xml version="1.0" encoding="UTF-8"?>
<!-- SF Desk add-in for Outlook: a "Create Deal Support" button on calendar meetings that opens SF Desk's
     create form in a task pane. Sideload the copy SF Desk serves at https://localhost:3443/outlook/manifest.xml,
     which carries the HTTPS port SF Desk runs on (see OUTLOOK.md). -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>be2355d4-33b7-40d4-88ff-d3fe930e57f8</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>SF Desk</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SF Desk"/>
  <Description DefaultValue="Create a Deal Support in Salesforce from a meeting, through SF Desk running on this computer."/>
  <IconUrl DefaultValue="https://localhost:3443/outlook/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3443/outlook/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/kclassen-kccs/sf-desk"/>
  <AppDomains>
    <AppDomain>https://localhost:3443</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3443/outlook/pane"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3443/outlook/pane"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- A meeting you were invited to. -->
          <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="sfDeskAttendeeGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="sfDeskAttendeeButton">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="PaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
          <!-- A meeting you organize. -->
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="sfDeskOrganizerGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="sfDeskOrganizerButton">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="PaneUrl"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://localhost:3443/outlook/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://localhost:3443/outlook/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://localhost:3443/outlook/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="PaneUrl" DefaultValue="https://localhost:3443/outlook/pane"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="SF Desk"/>
        <bt:String id="ButtonLabel" DefaultValue="Create Deal Support"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonTip" DefaultValue="Create a Deal Support in Salesforce from this meeting, prefilled by SF Desk."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
